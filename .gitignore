# =============================================================================
# AQI PREDICTION MLOPS — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments ---
venv/
env/
ENV/
.venv/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Environment & secrets ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log
logs/

# --- Temp / scratch ---
*.tmp
*.bak
*.cache
scratch_*.py

# --- Test / coverage ---
.coverage
htmlcov/
.pytest_cache/

# --- MLflow (local runs only; DagsHub remote is the source of truth) ---
mlruns/
mlartifacts/

# --- Claude / tool internals ---
.claude/

# =============================================================================
# DATA — tracked by DVC, not Git
# =============================================================================
/data/raw/*
!/data/raw/.gitkeep

/data/processed/*
!/data/processed/.gitkeep

/data/features/*
!/data/features/.gitkeep
# encoders.json is a small artifact produced by feature_engineering; keep it
!/data/features/encoders.json

/data/splits/*
!/data/splits/.gitkeep

# =============================================================================
# MODELS — intermediate artifacts ignored; deployable artifacts kept
# =============================================================================

# Intermediate training outputs (large, DVC-tracked)
/models/xgboost.json
/models/catboost.cbm
/models/random_forest.pkl
/models/extra_trees.pkl
/models/decision_tree.pkl
/models/training_metrics.json
/models/detailed_results.json
/models/features.txt

# Evaluation reports (regenerated by stage 8)
/models/evaluation/*
!/models/evaluation/.gitkeep

# Optimized model folder: KEEP in Git so deployment hosts see it
# (model.json.gz is 0.26 MB — well within Git limits)

# =============================================================================
# REPORTS
# =============================================================================
/reports/*.csv
/reports/*.json
/reports/prediction_plots/*
!/reports/prediction_plots/.gitkeep

# =============================================================================
# DVC internals
# =============================================================================
/dvc_cache/
.dvc/cache/
.dvc/tmp/
/iterative/
